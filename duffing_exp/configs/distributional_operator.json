{
  "seed": 42,
  "data": {
    "input_path": "duffing_dataset/duffing_dataset.h5",
    "input_dataset": "X",
    "target_path": "duffing_dataset/duffing_dataset.h5",
    "target_dataset": "Y",
    "train_size": 1000,
    "validation_size": 200,
    "test_size": 200,
    "batch_size": 8,
    "num_workers": 0,
    "pin_memory": true,
    "preprocessing": {
      "enabled": true,
      "name": "pca",
      "normalize": true,
      "input_dimension": 24,
      "target_dimension": 13,
      "state_path": "duffing_dataset/pca_transforms/duffing_seed{seed}_train{train_size}_x{input_dim}_y{target_dim}.npz",
      "fields_per_batch": 64,
      "rebuild": false
    }
  },
  "model": {
    "name": "distributional_operator",
    "distribution_encoder": {
      "name": "deepsets",
      "context_dim": 128,
      "sample_embed_dim": 128,
      "hidden_dim": 256,
      "phi_layers": 2,
      "rho_layers": 2,
      "aggregation": "mean"
    },
    "generator": {
      "name": "realnvp",
      "data_dim": 13,
      "num_layers": 12,
      "hidden_dim": 256,
      "coupling_hidden_layers": 2,
      "scale_limit": 2
    },
    "num_samples": 128,
    "temperature": 1
  },
  "loss": {
    "name": "sinkhorn",
    "p": 2,
    "blur": 0.01,
    "debias": true,
    "scaling": 0.5,
    "backend": "auto",
    "reduction": "mean",
    "mean_loss_weight": 0.0
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.001,
    "weight_decay": 0.05
  },
  "scheduler": {
    "name": "reduce_lr_on_plateau",
    "mode": "min",
    "factor": 0.6,
    "patience": 15,
    "threshold": 0.0001,
    "threshold_mode": "rel",
    "cooldown": 0,
    "min_lr": 0.000001,
    "eps": 1.0e-8
  },
  "training": {
    "pipeline": "standard",
    "epochs": 1000,
    "device": "cuda",
    "grad_clip": 1.0,
    "log_every": 1,
    "early_stopping": {
      "enabled": true,
      "patience": 30,
      "min_delta": 0.001
    }
  },
  "checkpoint": {
    "save_best": true,
    "save_last": true
  },
  "experiment": {
    "root": "experiments"
  }
}
