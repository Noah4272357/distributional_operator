{
  "seed": 42,
  "initial_condition": {
    "N_sample": 2,
    "Nx": 512,
    "domain": [-1.0, 1.0],
    "boundary_type": "periodic"
  },
  "process_type": "truncated_Gaussian",
  "process_args_range": {
    "truncated_Gaussian": {
      "trunc_dim": 8,
      "sigma": {"distribution": "uniform", "range": [0.5, 1.5]},
      "alpha": {"distribution": "loguniform", "range": [1.0, 10.0]},
      "s": {"distribution": "uniform", "range": [1.5, 4.0]}
    },
    "student_t": {
      "nu": 4.0,
      "trunc_dim": 8,
      "sigma": {"distribution": "uniform", "range": [0.5, 1.5]},
      "alpha": {"distribution": "loguniform", "range": [1.0, 10.0]},
      "s": {"distribution": "uniform", "range": [1.5, 4.0]}
    }
  },
  "N_process": 8,
  "solver": {
    "visc": 0.01,
    "T": 1.0,
    "device": null,
    "dt": null
  },
  "output_path": "dataset.h5"
}
